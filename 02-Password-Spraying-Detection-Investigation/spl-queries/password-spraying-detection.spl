
# Password Spraying Detection & Investigation - SPL Queries
# Lab: CORP Domain | Attacker: 192.168.56.103 (KALI)


# -----------------------------------------------------------------------------
# 1. Raw Failed Authentication Events (Event ID 4625)
# -----------------------------------------------------------------------------
index=* EventCode=4625
| table _time ComputerName Account_Name Account_Domain Source_Network_Address Workstation_Name Logon_Type Failure_Reason Authentication_Package
| sort _time


# -----------------------------------------------------------------------------
# 2. Password Spraying Source Analysis
#    (Count failed attempts + unique accounts + list of targeted accounts)
# -----------------------------------------------------------------------------
index=* EventCode=4625 Source_Network_Address="192.168.56.103"
| stats 
    count as failed_attempts 
    dc(Account_Name) as unique_accounts 
    values(Account_Name) as targeted_accounts 
    by Source_Network_Address
| sort -unique_accounts


# -----------------------------------------------------------------------------
# 3. Targeted Accounts Breakdown from Attacking IP
# -----------------------------------------------------------------------------
index=* EventCode=4625 Source_Network_Address="192.168.56.103"
| stats count by Account_Name
| sort -count


# -----------------------------------------------------------------------------
# 4. Successful Authentication Events (Event ID 4624)
# -----------------------------------------------------------------------------
index=* EventCode=4624
| table _time ComputerName Account_Name Account_Domain Source_Network_Address Workstation_Name Logon_Type Authentication_Package
| sort _time


# -----------------------------------------------------------------------------
# 5. Account Lockout Events (Event ID 4740)
# -----------------------------------------------------------------------------
index=* EventCode=4740
| table _time ComputerName Account_Name Account_Domain
| sort _time


# -----------------------------------------------------------------------------
# 6. Full Password Spraying Detection Query (recommended for alerts)
# -----------------------------------------------------------------------------
index=* EventCode=4625
| stats 
    count as failed_attempts 
    dc(Account_Name) as unique_accounts 
    values(Account_Name) as targeted_accounts 
    by Source_Network_Address
| where unique_accounts >= 5
| sort -unique_accounts
